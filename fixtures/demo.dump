INSERT INTO cards (id, anchor_id, headline, instantiated_md, full_md, substitutions, clause_ids, gloss, source_doc_id, source_page) VALUES ('b0000000000040008000000000002042'::uuid, 'b0000000000040008000000000001042'::uuid, 'Basis extension', 'Every linearly independent list extends to a basis of a finite dimensional space.', 'Every linearly independent list extends to a basis of a finite dimensional space.', '[]'::jsonb, '[]'::jsonb, 'Keep this earlier result in view while following the argument.', 'b0000000000040008000000000000001'::uuid, 2);
INSERT INTO cards (id, anchor_id, headline, instantiated_md, full_md, substitutions, clause_ids, gloss, source_doc_id, source_page) VALUES ('b0000000000040008000000000002043'::uuid, 'b0000000000040008000000000001043'::uuid, 'Direct sums', 'If U and W intersect only at zero, their sum is a direct sum.', 'If U and W intersect only at zero, their sum is a direct sum.', '[]'::jsonb, '[]'::jsonb, 'Keep this earlier result in view while following the argument.', 'b0000000000040008000000000000001'::uuid, 2);
INSERT INTO cards (id, anchor_id, headline, instantiated_md, full_md, substitutions, clause_ids, gloss, source_doc_id, source_page) VALUES ('b0000000000040008000000000002044'::uuid, 'b0000000000040008000000000001044'::uuid, 'Isomorphisms', 'An invertible linear map identifies two vector spaces of equal dimension.', 'An invertible linear map identifies two vector spaces of equal dimension.', '[]'::jsonb, '[]'::jsonb, 'Keep this earlier result in view while following the argument.', 'b0000000000040008000000000000001'::uuid, 2);
INSERT INTO cards (id, anchor_id, headline, instantiated_md, full_md, substitutions, clause_ids, gloss, source_doc_id, source_page) VALUES ('b0000000000040008000000000002045'::uuid, 'b0000000000040008000000000001045'::uuid, 'Composition', 'The composition of two linear maps is linear.', 'The composition of two linear maps is linear.', '[]'::jsonb, '[]'::jsonb, 'Keep this earlier result in view while following the argument.', 'b0000000000040008000000000000001'::uuid, 3);
INSERT INTO cards (id, anchor_id, headline, instantiated_md, full_md, substitutions, clause_ids, gloss, source_doc_id, source_page) VALUES ('b0000000000040008000000000002046'::uuid, 'b0000000000040008000000000001046'::uuid, 'Dimension formula', 'The dimension of U + W equals dim U + dim W minus dim of their intersection.', 'The dimension of U + W equals dim U + dim W minus dim of their intersection.', '[]'::jsonb, '[]'::jsonb, 'Keep this earlier result in view while following the argument.', 'b0000000000040008000000000000001'::uuid, 3);
INSERT INTO cards (id, anchor_id, headline, instantiated_md, full_md, substitutions, clause_ids, gloss, source_doc_id, source_page) VALUES ('b0000000000040008000000000002047'::uuid, 'b0000000000040008000000000001047'::uuid, 'Quotient spaces', 'The quotient V/U consists of cosets of U, with the induced vector operations.', 'The quotient V/U consists of cosets of U, with the induced vector operations.', '[]'::jsonb, '[]'::jsonb, 'Keep this earlier result in view while following the argument.', 'b0000000000040008000000000000001'::uuid, 3);
INSERT INTO cards (id, anchor_id, headline, instantiated_md, full_md, substitutions, clause_ids, gloss, source_doc_id, source_page) VALUES ('b0000000000040008000000000002048'::uuid, 'b0000000000040008000000000001048'::uuid, 'First isomorphism theorem', 'The quotient of V by ker T is isomorphic to the image of T.', 'The quotient of V by ker T is isomorphic to the image of T.', '[]'::jsonb, '[]'::jsonb, 'Keep this earlier result in view while following the argument.', 'b0000000000040008000000000000001'::uuid, 3);
INSERT INTO cards (id, anchor_id, headline, instantiated_md, full_md, substitutions, clause_ids, gloss, source_doc_id, source_page) VALUES ('b0000000000040008000000000002049'::uuid, 'b0000000000040008000000000001049'::uuid, 'Vector spaces', 'A vector space is a set closed under addition and scalar multiplication.', 'A vector space is a set closed under addition and scalar multiplication.', '[]'::jsonb, '[]'::jsonb, 'Keep this earlier result in view while following the argument.', 'b0000000000040008000000000000001'::uuid, 1);
INSERT INTO cards (id, anchor_id, headline, instantiated_md, full_md, substitutions, clause_ids, gloss, source_doc_id, source_page) VALUES ('b0000000000040008000000000002050'::uuid, 'b0000000000040008000000000001050'::uuid, 'Linear maps', 'A map T is linear when T(au + bv) = aT(u) + bT(v).', 'A map T is linear when T(au + bv) = aT(u) + bT(v).', '[]'::jsonb, '[]'::jsonb, 'Keep this earlier result in view while following the argument.', 'b0000000000040008000000000000001'::uuid, 1);
INSERT INTO cards (id, anchor_id, headline, instantiated_md, full_md, substitutions, clause_ids, gloss, source_doc_id, source_page) VALUES ('b0000000000040008000000000002051'::uuid, 'b0000000000040008000000000001051'::uuid, 'Kernel and image', 'The kernel is the set of vectors sent to zero. The image is the range of T.', 'The kernel is the set of vectors sent to zero. The image is the range of T.', '[]'::jsonb, '[]'::jsonb, 'Keep this earlier result in view while following the argument.', 'b0000000000040008000000000000001'::uuid, 1);
