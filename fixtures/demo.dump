INSERT INTO nodes (id, doc_id, kind, label, title, statement_md, clauses, symbols, page, bbox, entity_id, confidence) VALUES ('b0000000000040008000000000000100'::uuid, 'b0000000000040008000000000000001'::uuid, 'definition', 'Definition 3.1', 'Vector spaces', 'A vector space is a set closed under addition and scalar multiplication.', '[]'::jsonb, '[]'::jsonb, 1, '{62.0,172.0,550.0,234.0}'::float8[], 'b0000000000040008000000000000500'::uuid, 0.98);
INSERT INTO nodes (id, doc_id, kind, label, title, statement_md, clauses, symbols, page, bbox, entity_id, confidence) VALUES ('b0000000000040008000000000000101'::uuid, 'b0000000000040008000000000000001'::uuid, 'definition', 'Definition 3.2', 'Linear maps', 'A map T is linear when T(au + bv) = aT(u) + bT(v).', '[]'::jsonb, '[]'::jsonb, 1, '{62.0,307.0,550.0,369.0}'::float8[], 'b0000000000040008000000000000501'::uuid, 0.98);
INSERT INTO nodes (id, doc_id, kind, label, title, statement_md, clauses, symbols, page, bbox, entity_id, confidence) VALUES ('b0000000000040008000000000000102'::uuid, 'b0000000000040008000000000000001'::uuid, 'definition', 'Definition 3.3', 'Kernel and image', 'The kernel is the set of vectors sent to zero. The image is the range of T.', '[]'::jsonb, '[]'::jsonb, 1, '{62.0,442.0,550.0,504.0}'::float8[], 'b0000000000040008000000000000502'::uuid, 0.64);
INSERT INTO nodes (id, doc_id, kind, label, title, statement_md, clauses, symbols, page, bbox, entity_id, confidence) VALUES ('b0000000000040008000000000000103'::uuid, 'b0000000000040008000000000000001'::uuid, 'theorem', 'Theorem 3.4', 'Rank-Nullity', '(i) The kernel and image of A are subspaces. (ii) If V is finite dimensional, dim ker A + dim im A = dim V.', '[]'::jsonb, '[]'::jsonb, 1, '{62.0,577.0,550.0,639.0}'::float8[], 'b0000000000040008000000000000503'::uuid, 0.98);
INSERT INTO nodes (id, doc_id, kind, label, title, statement_md, clauses, symbols, page, bbox, entity_id, confidence) VALUES ('b0000000000040008000000000000104'::uuid, 'b0000000000040008000000000000001'::uuid, 'corollary', 'Corollary 3.5', 'Injectivity criterion', 'A linear map is injective if and only if its kernel contains only zero.', '[]'::jsonb, '[]'::jsonb, 2, '{62.0,172.0,550.0,234.0}'::float8[], 'b0000000000040008000000000000504'::uuid, 0.98);
INSERT INTO nodes (id, doc_id, kind, label, title, statement_md, clauses, symbols, page, bbox, entity_id, confidence) VALUES ('b0000000000040008000000000000105'::uuid, 'b0000000000040008000000000000001'::uuid, 'lemma', 'Lemma 3.6', 'Basis extension', 'Every linearly independent list extends to a basis of a finite dimensional space.', '[]'::jsonb, '[]'::jsonb, 2, '{62.0,307.0,550.0,369.0}'::float8[], 'b0000000000040008000000000000505'::uuid, 0.98);
INSERT INTO nodes (id, doc_id, kind, label, title, statement_md, clauses, symbols, page, bbox, entity_id, confidence) VALUES ('b0000000000040008000000000000106'::uuid, 'b0000000000040008000000000000001'::uuid, 'definition', 'Definition 3.7', 'Direct sums', 'If U and W intersect only at zero, their sum is a direct sum.', '[]'::jsonb, '[]'::jsonb, 2, '{62.0,442.0,550.0,504.0}'::float8[], 'b0000000000040008000000000000506'::uuid, 0.98);
INSERT INTO nodes (id, doc_id, kind, label, title, statement_md, clauses, symbols, page, bbox, entity_id, confidence) VALUES ('b0000000000040008000000000000107'::uuid, 'b0000000000040008000000000000001'::uuid, 'definition', 'Definition 3.8', 'Isomorphisms', 'An invertible linear map identifies two vector spaces of equal dimension.', '[]'::jsonb, '[]'::jsonb, 2, '{62.0,577.0,550.0,639.0}'::float8[], 'b0000000000040008000000000000507'::uuid, 0.98);
INSERT INTO nodes (id, doc_id, kind, label, title, statement_md, clauses, symbols, page, bbox, entity_id, confidence) VALUES ('b0000000000040008000000000000108'::uuid, 'b0000000000040008000000000000001'::uuid, 'proposition', 'Proposition 3.9', 'Composition', 'The composition of two linear maps is linear.', '[]'::jsonb, '[]'::jsonb, 3, '{62.0,172.0,550.0,234.0}'::float8[], 'b0000000000040008000000000000508'::uuid, 0.98);
INSERT INTO nodes (id, doc_id, kind, label, title, statement_md, clauses, symbols, page, bbox, entity_id, confidence) VALUES ('b0000000000040008000000000000109'::uuid, 'b0000000000040008000000000000001'::uuid, 'theorem', 'Theorem 3.10', 'Dimension formula', 'The dimension of U + W equals dim U + dim W minus dim of their intersection.', '[]'::jsonb, '[]'::jsonb, 3, '{62.0,307.0,550.0,369.0}'::float8[], 'b0000000000040008000000000000509'::uuid, 0.98);
INSERT INTO nodes (id, doc_id, kind, label, title, statement_md, clauses, symbols, page, bbox, entity_id, confidence) VALUES ('b0000000000040008000000000000110'::uuid, 'b0000000000040008000000000000001'::uuid, 'definition', 'Definition 3.11', 'Quotient spaces', 'The quotient V/U consists of cosets of U, with the induced vector operations.', '[]'::jsonb, '[]'::jsonb, 3, '{62.0,442.0,550.0,504.0}'::float8[], 'b0000000000040008000000000000510'::uuid, 0.98);
INSERT INTO nodes (id, doc_id, kind, label, title, statement_md, clauses, symbols, page, bbox, entity_id, confidence) VALUES ('b0000000000040008000000000000111'::uuid, 'b0000000000040008000000000000001'::uuid, 'theorem', 'Theorem 3.12', 'First isomorphism theorem', 'The quotient of V by ker T is isomorphic to the image of T.', '[]'::jsonb, '[]'::jsonb, 3, '{62.0,577.0,550.0,639.0}'::float8[], 'b0000000000040008000000000000511'::uuid, 0.98);
INSERT INTO nodes (id, doc_id, kind, label, title, statement_md, clauses, symbols, page, bbox, entity_id, confidence) VALUES ('b0000000000040008000000000000112'::uuid, 'b0000000000040008000000000000001'::uuid, 'proof', 'Proof 3.4', 'Why Rank-Nullity holds', 'Let T: V -> W be linear, with V finite dimensional. Choose a basis v(1), ..., v(k) of the kernel of T. By Basis extension, complete this to a basis v(1), ..., v(n) of V. We claim T(v(k+1)), ..., T(v(n)) is a basis of the image of T. Linearity shows that these vectors span the image. To prove independence, suppose a linear combination of them is zero. Then the corresponding combination of v(k+1), ..., v(n) lies in ker T. By Kernel and image, this is a combination of v(1), ..., v(k). Independence of the full basis forces every coefficient to vanish. Thus dim ker T = k, while dim im T = n - k. Adding the two dimensions gives dim V = n, as required.', '[]'::jsonb, '[]'::jsonb, 4, '{62.0,180.0,555.0,590.0}'::float8[], NULL, 1.0);
INSERT INTO nodes (id, doc_id, kind, label, title, statement_md, clauses, symbols, page, bbox, entity_id, confidence) VALUES ('b0000000000040008000000000000120'::uuid, 'b0000000000040008000000000000002'::uuid, 'definition', 'Definition 3.1', 'Vector spaces', 'A vector space is a set closed under addition and scalar multiplication.', '[]'::jsonb, '[]'::jsonb, 1, '{62.0,172.0,550.0,234.0}'::float8[], 'b0000000000040008000000000000500'::uuid, 0.98);
