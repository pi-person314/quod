INSERT INTO cards (id, anchor_id, headline, instantiated_md, full_md, substitutions, clause_ids, gloss, source_doc_id, source_page) VALUES ('b0000000000040008000000000002000'::uuid, 'b0000000000040008000000000001000'::uuid, 'Rank-Nullity · clause (ii)',  E'$\\dim\\ker T + \\dim\\operatorname{im} T = n$. Every input dimension is either lost in the kernel or preserved in the image.', '(i) The kernel and image of A are subspaces. (ii) If V is finite dimensional, dim ker A + dim im A = dim V.',  E'[{"to": "T", "from": "A"}, {"to": "\\\\mathbb{R}^{n}", "from": "V"}]'::jsonb, '["ii"]'::jsonb, 'The dimensions that disappear and the dimensions that survive add up to the whole space.', 'b0000000000040008000000000000001'::uuid, 1);
INSERT INTO cards (id, anchor_id, headline, instantiated_md, full_md, substitutions, clause_ids, gloss, source_doc_id, source_page) VALUES ('b0000000000040008000000000002001'::uuid, 'b0000000000040008000000000001001'::uuid, 'Injectivity criterion', 'A linear map is injective if and only if its kernel contains only zero.', 'A linear map is injective if and only if its kernel contains only zero.', '[]'::jsonb, '[]'::jsonb, 'Keep this earlier result in view while following the argument.', 'b0000000000040008000000000000001'::uuid, 2);
INSERT INTO cards (id, anchor_id, headline, instantiated_md, full_md, substitutions, clause_ids, gloss, source_doc_id, source_page) VALUES ('b0000000000040008000000000002002'::uuid, 'b0000000000040008000000000001002'::uuid, 'Basis extension', 'Every linearly independent list extends to a basis of a finite dimensional space.', 'Every linearly independent list extends to a basis of a finite dimensional space.', '[]'::jsonb, '[]'::jsonb, 'Keep this earlier result in view while following the argument.', 'b0000000000040008000000000000001'::uuid, 2);
INSERT INTO cards (id, anchor_id, headline, instantiated_md, full_md, substitutions, clause_ids, gloss, source_doc_id, source_page) VALUES ('b0000000000040008000000000002003'::uuid, 'b0000000000040008000000000001003'::uuid, 'Direct sums', 'If U and W intersect only at zero, their sum is a direct sum.', 'If U and W intersect only at zero, their sum is a direct sum.', '[]'::jsonb, '[]'::jsonb, 'Keep this earlier result in view while following the argument.', 'b0000000000040008000000000000001'::uuid, 2);
INSERT INTO cards (id, anchor_id, headline, instantiated_md, full_md, substitutions, clause_ids, gloss, source_doc_id, source_page) VALUES ('b0000000000040008000000000002004'::uuid, 'b0000000000040008000000000001004'::uuid, 'Isomorphisms', 'An invertible linear map identifies two vector spaces of equal dimension.', 'An invertible linear map identifies two vector spaces of equal dimension.', '[]'::jsonb, '[]'::jsonb, 'Keep this earlier result in view while following the argument.', 'b0000000000040008000000000000001'::uuid, 2);
INSERT INTO cards (id, anchor_id, headline, instantiated_md, full_md, substitutions, clause_ids, gloss, source_doc_id, source_page) VALUES ('b0000000000040008000000000002005'::uuid, 'b0000000000040008000000000001005'::uuid, 'Composition', 'The composition of two linear maps is linear.', 'The composition of two linear maps is linear.', '[]'::jsonb, '[]'::jsonb, 'Keep this earlier result in view while following the argument.', 'b0000000000040008000000000000001'::uuid, 3);
INSERT INTO cards (id, anchor_id, headline, instantiated_md, full_md, substitutions, clause_ids, gloss, source_doc_id, source_page) VALUES ('b0000000000040008000000000002006'::uuid, 'b0000000000040008000000000001006'::uuid, 'Dimension formula', 'The dimension of U + W equals dim U + dim W minus dim of their intersection.', 'The dimension of U + W equals dim U + dim W minus dim of their intersection.', '[]'::jsonb, '[]'::jsonb, 'Keep this earlier result in view while following the argument.', 'b0000000000040008000000000000001'::uuid, 3);
INSERT INTO cards (id, anchor_id, headline, instantiated_md, full_md, substitutions, clause_ids, gloss, source_doc_id, source_page) VALUES ('b0000000000040008000000000002007'::uuid, 'b0000000000040008000000000001007'::uuid, 'Quotient spaces', 'The quotient V/U consists of cosets of U, with the induced vector operations.', 'The quotient V/U consists of cosets of U, with the induced vector operations.', '[]'::jsonb, '[]'::jsonb, 'Keep this earlier result in view while following the argument.', 'b0000000000040008000000000000001'::uuid, 3);
INSERT INTO cards (id, anchor_id, headline, instantiated_md, full_md, substitutions, clause_ids, gloss, source_doc_id, source_page) VALUES ('b0000000000040008000000000002008'::uuid, 'b0000000000040008000000000001008'::uuid, 'First isomorphism theorem', 'The quotient of V by ker T is isomorphic to the image of T.', 'The quotient of V by ker T is isomorphic to the image of T.', '[]'::jsonb, '[]'::jsonb, 'Keep this earlier result in view while following the argument.', 'b0000000000040008000000000000001'::uuid, 3);
INSERT INTO cards (id, anchor_id, headline, instantiated_md, full_md, substitutions, clause_ids, gloss, source_doc_id, source_page) VALUES ('b0000000000040008000000000002009'::uuid, 'b0000000000040008000000000001009'::uuid, 'Vector spaces', 'A vector space is a set closed under addition and scalar multiplication.', 'A vector space is a set closed under addition and scalar multiplication.', '[]'::jsonb, '[]'::jsonb, 'Keep this earlier result in view while following the argument.', 'b0000000000040008000000000000001'::uuid, 1);
INSERT INTO cards (id, anchor_id, headline, instantiated_md, full_md, substitutions, clause_ids, gloss, source_doc_id, source_page) VALUES ('b0000000000040008000000000002010'::uuid, 'b0000000000040008000000000001010'::uuid, 'Linear maps', 'A map T is linear when T(au + bv) = aT(u) + bT(v).', 'A map T is linear when T(au + bv) = aT(u) + bT(v).', '[]'::jsonb, '[]'::jsonb, 'Keep this earlier result in view while following the argument.', 'b0000000000040008000000000000001'::uuid, 1);
INSERT INTO cards (id, anchor_id, headline, instantiated_md, full_md, substitutions, clause_ids, gloss, source_doc_id, source_page) VALUES ('b0000000000040008000000000002011'::uuid, 'b0000000000040008000000000001011'::uuid, 'Kernel and image', 'The kernel is the set of vectors sent to zero. The image is the range of T.', 'The kernel is the set of vectors sent to zero. The image is the range of T.', '[]'::jsonb, '[]'::jsonb, 'Keep this earlier result in view while following the argument.', 'b0000000000040008000000000000001'::uuid, 1);
INSERT INTO cards (id, anchor_id, headline, instantiated_md, full_md, substitutions, clause_ids, gloss, source_doc_id, source_page) VALUES ('b0000000000040008000000000002012'::uuid, 'b0000000000040008000000000001012'::uuid, 'Basis extension', 'Every linearly independent list extends to a basis of a finite dimensional space.', 'Every linearly independent list extends to a basis of a finite dimensional space.', '[]'::jsonb, '[]'::jsonb, 'A basis for a smaller space can be completed to one for the whole space.', 'b0000000000040008000000000000001'::uuid, 2);
INSERT INTO cards (id, anchor_id, headline, instantiated_md, full_md, substitutions, clause_ids, gloss, source_doc_id, source_page) VALUES ('b0000000000040008000000000002013'::uuid, 'b0000000000040008000000000001013'::uuid, 'Kernel and image', 'The kernel is the set of vectors sent to zero. The image is the range of T.', 'The kernel is the set of vectors sent to zero. The image is the range of T.', '[]'::jsonb, '[]'::jsonb, 'A vector lies in the kernel precisely when the map sends it to zero.', 'b0000000000040008000000000000001'::uuid, 1);
