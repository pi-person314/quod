INSERT INTO nodes (id, doc_id, kind, label, title, statement_md, clauses, symbols, page, bbox, entity_id, confidence) VALUES ('b0000000000040008000000000000170'::uuid, 'b0000000000040008000000000000004'::uuid, 'definition', 'Definition 3.11', 'Quotient spaces', 'The quotient V/U consists of cosets of U, with the induced vector operations.', '[]'::jsonb, '[]'::jsonb, 3, '{62.0,442.0,550.0,504.0}'::float8[], 'b0000000000040008000000000000510'::uuid, 0.98);
INSERT INTO nodes (id, doc_id, kind, label, title, statement_md, clauses, symbols, page, bbox, entity_id, confidence) VALUES ('b0000000000040008000000000000171'::uuid, 'b0000000000040008000000000000004'::uuid, 'theorem', 'Theorem 3.12', 'First isomorphism theorem', 'The quotient of V by ker T is isomorphic to the image of T.', '[]'::jsonb, '[]'::jsonb, 3, '{62.0,577.0,550.0,639.0}'::float8[], 'b0000000000040008000000000000511'::uuid, 0.98);
