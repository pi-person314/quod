      "headline": "Rank-Nullity · clause (ii)",
      "instantiated_md": "$\\dim\\ker T + \\dim\\operatorname{im} T = n$. Every input dimension is either lost in the kernel or preserved in the image.",
      "full_md": "(i) The kernel and image of A are subspaces. (ii) If V is finite dimensional, dim ker A + dim im A = dim V.",
      "substitutions": [
        {
          "from": "A",
          "to": "T"
        },
        {
          "from": "V",
          "to": "\\mathbb{R}^{n}"
        }
      ],
      "clause_ids": [
        "ii"
      ],
      "gloss": "The dimensions that disappear and the dimensions that survive add up to the whole space.",
      "source": {
        "doc_id": "b0000000-0000-4000-8000-000000000001",
        "page": 1
      }
    },
