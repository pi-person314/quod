{
  "name": "@quod/intel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./voice": "./voice/server.ts",
    "./voice/relay": "./voice/relay.ts",
    "./voice/client": "./voice/client.ts"
  },
  "scripts": {
    "test": "node --import tsx --test tests/*.test.ts",
    "fixtures:generate": "node --import tsx evals/generate-fixtures.ts",
    "eval:offline": "node --import tsx evals/run-offline.ts",
    "test:db": "node --import tsx scripts/check-database.ts",
    "test:budget": "node --import tsx scripts/check-budget.ts",
    "test:search": "node --import tsx scripts/check-search.ts",
    "typecheck": "tsc --noEmit",
    "cost-report": "node --import tsx scripts/cost-report.ts",
    "cost-compare": "node --import tsx scripts/compare-costs.ts"
  },
  "dependencies": {
    "@quod/contracts": "workspace:*",
    "openai": "^5.0.0",
    "ws": "^8.21.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
