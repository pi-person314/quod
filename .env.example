# Copy to .env at the repo root. Both apps/web and apps/worker read it.

# --- Fixture mode (keep this working to the end; it is the demo fallback) ---
USE_FIXTURES=1

# --- Infra (docker compose up -d gives you both) ---
DATABASE_URL=postgres://cairn:cairn@localhost:5432/cairn
ELASTICSEARCH_URL=http://localhost:9200

# --- Models (OpenAI; the whole stack is one track) ---
OPENAI_API_KEY=
# Bulk classification (segmentation, edge extraction). $0.20 / $1.20 per MTok.
MODEL_FAST=gpt-5.6-luna
# Instantiation and resolution: the two calls a judge sees. $4 / $20 per MTok (promo through 2026-11-21).
MODEL_QUALITY=gpt-5.6-sol
# Dense vectors for the Elasticsearch hybrid index.
EMBEDDING_MODEL=text-embedding-3-small

# --- Worker -> web API (resolve, bake are C-owned handlers the worker calls) ---
WEB_BASE_URL=http://localhost:3000

# --- Voice (F8, P2) ---
DEEPGRAM_API_KEY=
