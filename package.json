{
  "name": "cairn",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "pnpm --filter @cairn/web dev",
    "build": "pnpm --filter @cairn/web build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test:contracts": "pnpm --filter @cairn/contracts test",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "db:schema": "docker compose exec -T postgres psql -U cairn -d cairn -v ON_ERROR_STOP=1 -f /contracts/schema.sql"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
